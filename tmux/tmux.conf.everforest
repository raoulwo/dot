# Reload configuration using `r`
bind -r r source-file ~/.config/tmux/tmux.conf

# Enable vi mode
set -g mode-keys vi
set -g status-keys vi

# Enable the mouse
set -g mouse on

# Allow automatic renaming of windows
# set -g allow-rename on

# Set terminal colors
set-option -g default-terminal "tmux-256color"

# Set delay between prefix and command
set -s escape-time 0

# Start windows with index 1
set -g base-index 1
# Start panes with index 1
setw -g pane-base-index 1
# Renumber the windows should a window be closed
set -g renumber-windows on

# Cycle through windows
bind -r C-p select-window -t :-
bind -r C-n select-window -t :+

# Navigate panes using vi motion
bind -r h select-pane -L
bind -r j select-pane -D
bind -r k select-pane -U
bind -r l select-pane -R

# Resize panes using vi motions
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# Smart pane switching with awareness of vim splits
is_vim='echo "#{pane_current_command}" | grep -iqE "(^|\/)g?(view|n?vim?)(diff)?$"'
bind -n C-h if-shell "$is_vim" "send-keys C-h" "select-pane -L"
bind -n C-j if-shell "$is_vim" "send-keys C-j" "select-pane -D"
bind -n C-k if-shell "$is_vim" "send-keys C-k" "select-pane -U"
bind -n C-l if-shell "$is_vim" "send-keys C-l" "select-pane -R"

# Switch between two most recently used windows
bind Space last-window

# Switch between two most recently used sessions
bind ^ switch-client -l

# Decrease the repeat time
set -g repeat-time 250

# Bind `&` to kill window including panes
bind-key & kill-window

# Copy mode keybindings
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi C-v send-keys -X rectangle-toggle
bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel

bind-key -r F new-window t
bind-key -r D run-shell "t $DOT"

# Pane border colors
set -g pane-border-style "fg=#293136"
set -g pane-active-border-style "fg=#293136"

# Status bar positioning
# set -g status-position bottom

# Move the session name to the right of the status bar
# set -g status-right "#S"
# Disable the left part of the status bar
# set -g status-left ""

# Status bar colors
# set -g status-style "fg=#859289 bg=default"
# set -g window-status-current-style "fg=#a7c080"

# Message colors
# set -g message-style "fg=#e67e80 bg=default"

# set -g status-position bottom
# set -g status-justify left

# -------------------------------------------------------------------
# Status Bar Styling (Lualine / Powerline Style)
# -------------------------------------------------------------------
set -g status-position bottom
set -g status-justify left

# Base status bar style: Solid #3a464c background with muted text
set -g status-style "fg=#859289 bg=#3a464c"

# Left side: Session name inside a solid soft red block (#e67e80)
set -g status-left "#[fg=#2f383e,bg=#e67e80,bold] #S #[fg=#e67e80,bg=#3a464c,nobold]"
set -g status-left-length 50

# Right side: Minimal empty space inheriting the #3a464c background
set -g status-right ""

# Inactive windows: Matches the #3a464c background completely
set -g window-status-format "#[fg=#3a464c,bg=#3a464c]#[fg=#859289,bg=#3a464c] #I:#W #[fg=#3a464c,bg=#3a464c]"

# Active window: Bright soft blue accent block (#7fbbb3)
set -g window-status-current-format "#[fg=#3a464c,bg=#7fbbb3]#[fg=#2f383e,bg=#7fbbb3,bold] #I:#W #[fg=#7fbbb3,bg=#3a464c,nobold]"

# Message/Command prompt styling
set -g message-style "fg=#e67e80 bg=#3a464c"
set -g message-command-style "fg=#e67e80 bg=#3a464c"
