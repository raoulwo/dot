# Reload configuration using `r`
bind -r r source-file ~/.config/tmux/tmux.conf

# Enable vi mode
set -g mode-keys vi
set -g status-keys vi

# Enable the mouse
set -g mouse on

# Allow automatic renaming of windows
# set -g allow-rename on

# Set terminal colors
set-option -g default-terminal "tmux-256color"

# Set delay between prefix and command
set -s escape-time 0

# Start windows with index 1
set -g base-index 1
# Start panes with index 1
setw -g pane-base-index 1
# Renumber the windows should a window be closed
set -g renumber-windows on

# Cycle through windows
bind -r C-p select-window -t :-
bind -r C-n select-window -t :+

# Navigate panes using vi motion
bind -r h select-pane -L
bind -r j select-pane -D
bind -r k select-pane -U
bind -r l select-pane -R

# Resize panes using vi motions
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# Smart pane switching with awareness of vim splits
is_vim='echo "#{pane_current_command}" | grep -iqE "(^|\/)g?(view|n?vim?)(diff)?$"'
bind -n C-h if-shell "$is_vim" "send-keys C-h" "select-pane -L"
bind -n C-j if-shell "$is_vim" "send-keys C-j" "select-pane -D"
bind -n C-k if-shell "$is_vim" "send-keys C-k" "select-pane -U"
bind -n C-l if-shell "$is_vim" "send-keys C-l" "select-pane -R"

# Switch between two most recently used windows
bind Space last-window

# Switch between two most recently used sessions
bind ^ switch-client -l

# Decrease the repeat time
set -g repeat-time 250

# Bind `&` to kill window including panes
bind-key & kill-window

# Copy mode keybindings
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi C-v send-keys -X rectangle-toggle
bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel

bind-key -r F new-window t
bind-key -r D run-shell "t $DOT"

# Gruvbox Material Dark Hard - UI Styles
set -g mode-style "fg=#ea6962,bg=#3c3836"

set -g message-style "fg=#ea6962,bg=#282828"
set -g message-command-style "fg=#ea6962,bg=#282828"

set -g pane-border-style "fg=#3c3836"
set -g pane-active-border-style "fg=#7daea3"

set -g status "on"
set -g status-position bottom
set -g status-justify "left"

set -g status-style "fg=#928374,bg=#282828"

set -g status-left-length "100"
set -g status-right-length "100"

set -g status-left-style NONE
set -g status-right-style NONE

# Left side: Session name inside soft red block (#ea6962) with dark hard text (#1d2021)
set -g status-left "#[fg=#1d2021,bg=#ea6962,bold] #S #[fg=#ea6962,bg=#282828,nobold,nounderscore,noitalics]"

# Right side: Prefix highlight, Date/Time, Hostname with Gruvbox tones
set -g status-right "#[fg=#282828,bg=#282828,nobold,nounderscore,noitalics]#[fg=#d8a657,bg=#282828] #{prefix_highlight} #[fg=#3c3836,bg=#282828,nobold,nounderscore,noitalics]#[fg=#7daea3,bg=#3c3836] %Y-%m-%d  %I:%M %p #[fg=#7daea3,bg=#3c3836,nobold,nounderscore,noitalics]#[fg=#1d2021,bg=#7daea3,bold] #h "
if-shell '[ "$(tmux show-option -gqv "clock-mode-style")" == "24" ]' {
  set -g status-right "#[fg=#282828,bg=#282828,nobold,nounderscore,noitalics]#[fg=#d8a657,bg=#282828] #{prefix_highlight} #[fg=#3c3836,bg=#282828,nobold,nounderscore,noitalics]#[fg=#7daea3,bg=#3c3836] %Y-%m-%d  %H:%M #[fg=#7daea3,bg=#3c3836,nobold,nounderscore,noitalics]#[fg=#1d2021,bg=#7daea3,bold] #h "
}

setw -g window-status-activity-style "underscore,fg=#928374,bg=#282828"
setw -g window-status-separator ""
setw -g window-status-style "NONE,fg=#928374,bg=#282828"
setw -g window-status-format "#[fg=#282828,bg=#282828,nobold,nounderscore,noitalics]#[default] #I  #W #F #[fg=#282828,bg=#282828,nobold,nounderscore,noitalics]"

# Active window: Soft blue accent block (#7daea3)
setw -g window-status-current-format "#[fg=#282828,bg=#3c3836,nobold,nounderscore,noitalics]#[fg=#7daea3,bg=#3c3836,bold] #I  #W #F #[fg=#3c3836,bg=#282828,nobold,nounderscore,noitalics]"

# tmux-plugins/tmux-prefix-highlight support mapped to Gruvbox yellow/orange (#d8a657)
set -g @prefix_highlight_output_prefix "#[fg=#d8a657]#[bg=#282828]#[fg=#282828]#[bg=#d8a657]"
set -g @prefix_highlight_output_suffix ""
